{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "announcements-route": {
        "ClusterId": "announcements-cluster",
        "Match": {
          "Path": "/api/announcements/{**catch-all}"
        }
      },
      "bookings-route": {
        "ClusterId": "bookings-cluster",
        "Match": {
          "Path": "/api/bookings/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "announcements-cluster": {
        "Destinations": {
          "announcements-destination": {
            "Address": "https://localhost:5010"
          }
        }
      },
      "bookings-cluster": {
        "Destinations": {
          "bookings-destination": {
            "Address": "https://localhost:5020"
          }
        }
      }
    }
  }
}