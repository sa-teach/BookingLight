{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "announcements-route": {
        "ClusterId": "announcements-cluster",
        "Match": {
          "Path": "/api/announcements/{**catch-all}"
        }
      }

      // TODO : Настроить маршрут и кластер для Bookings.API на порт 5020 (/api/bookings/{**catch-all})
      // ,"bookings-route": { ... }
    },
    "Clusters": {
      "announcements-cluster": {
        "Destinations": {
          "announcements-destination": {
            "Address": "https://localhost:5010"
          }
        }
      }

      // TODO : Настроить кластер для Bookings.API (адрес https://localhost:5020)
      // ,"bookings-cluster": { ... }
    }
  }
}
}
